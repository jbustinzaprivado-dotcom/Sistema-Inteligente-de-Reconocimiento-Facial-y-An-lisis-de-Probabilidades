# Cadena de conexion directa a Postgres del proyecto Supabase.
# Supabase > Project Settings > Database > Connection string (modo "URI", usar el pooler en modo "Session").
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@HOST:5432/postgres

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=rostros

# Origen permitido para CORS (URL del frontend en desarrollo)
FRONTEND_ORIGIN=http://localhost:5173
